# Copy to .env and fill in. .env is gitignored and must never be committed.

# ---- Search (Phase 1) ----
# SerpApi private key, from https://serpapi.com/manage-api-key
# 64 hex characters. Used for the Image upload API and the google_lens engine.
SERPAPI_KEY=

# ---- Blockchain (Phase 4) ----
# Polygon Amoy JSON-RPC endpoint. Alchemy form:
#   https://polygon-amoy.g.alchemy.com/v2/<ALCHEMY_API_KEY>
# The Alchemy API key belongs HERE, inside this URL - nowhere else.
POLYGON_RPC_URL=https://rpc-amoy.polygon.technology

# The EOA private key that signs anchoring transactions.
#
# REQUIRED VALUE: the 64-hex-character secp256k1 private key of a throwaway
# Polygon Amoy wallet, e.g. from MetaMask ->  Account details -> Show private
# key. Either "0x"-prefixed (66 chars) or bare (64 chars) is accepted.
#
#   correct : 4f3c...   (64 hex chars, or 0x + 64 hex chars)
#   WRONG   : an Alchemy API key
#   WRONG   : a wallet address (0x + 40 hex chars - that is CONTRACT_ADDRESS
#             or the derived sender, not the signing key)
#   WRONG   : a seed phrase / mnemonic
#
# This wallet holds only Amoy testnet POL. Never put a mainnet key here.
# Preflight validates the shape and derives the address; it never prints
# the key itself.
PRIVATE_KEY=

# Address of the deployed IdentityAnchor contract (0x + 40 hex chars).
# Populated by scripts/deploy.py in Phase 4.
CONTRACT_ADDRESS=

# ---- Face matching ----
# PROVISIONAL. Phase 0 measured the buffalo_l (w600k_r50) cosine similarity
# distribution on a small corpus (4 same-person pairs, 32 different-person
# pairs): same person 0.3994-0.7774, different person -0.1381-0.0887.
# 0.30 sits inside that gap. See README "Threshold" before trusting it.
FACE_MATCH_THRESHOLD=0.30

# ---- Vision ----
FACE_MODEL_NAME=buffalo_l
FACE_DET_SIZE=640
MIN_DET_SCORE=0.50
MIN_IMAGE_DIM=64
MIN_FACE_PIXELS=40
MIN_BLUR_VARIANCE=10.0

# ---- Discovery (Phase 1) ----
MAX_CANDIDATES=25
RETRIEVAL_CONCURRENCY=5
# requests applies a scalar timeout to connect AND read separately, so a
# single value of N bounds a request at ~2N. Split so the worst case is stated.
RETRIEVAL_CONNECT_TIMEOUT=6.0
RETRIEVAL_READ_TIMEOUT=12.0

# ---- Pipeline ----
PIPELINE_VERSION=1.0.0
