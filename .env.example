# ---- Search (Phase 1) ----
SERPAPI_KEY=

# ---- Blockchain (Phase 4) ----
POLYGON_RPC_URL=https://rpc-amoy.polygon.technology
PRIVATE_KEY=
CONTRACT_ADDRESS=

# ---- Face matching ----
# PROVISIONAL. Phase 0 measured the buffalo_l (w600k_r50) similarity
# distribution on a small corpus; see README "Threshold" before trusting it.
FACE_MATCH_THRESHOLD=0.30

# ---- Vision ----
FACE_MODEL_NAME=buffalo_l
FACE_DET_SIZE=640
MIN_DET_SCORE=0.50
MIN_IMAGE_DIM=64
MIN_FACE_PIXELS=40
MIN_BLUR_VARIANCE=10.0

# ---- Discovery (Phase 1) ----
MAX_CANDIDATES=25
RETRIEVAL_CONCURRENCY=5
RETRIEVAL_CONNECT_TIMEOUT=6.0
RETRIEVAL_READ_TIMEOUT=12.0

# ---- Pipeline ----
PIPELINE_VERSION=1.0.0
